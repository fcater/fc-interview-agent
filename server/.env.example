# AI 面试模拟 Agent — 环境变量样例
# 复制为 .env 后按需修改（.env 不入库；key 一律走环境变量）

# ── 运行模式 ──────────────────────────────────────────────────
# local = 本机 Ollama 小模型（开发默认，无 key 无外网；需先 ollama pull 模型）
# online = 在线模型（生产；OpenAI 兼容协议，需要 API key）
APP_LLM_MODE=local

# ── 对话模型：local 模式（本机 Ollama） ───────────────────────
# 模型需先拉取：ollama pull qwen3:8b（内存紧张可换 qwen3:4b）
APP_CHAT_PROVIDER=ollama
APP_CHAT_MODEL=qwen3:8b
APP_OLLAMA_BASE_URL=http://localhost:11434

# ── 对话模型：online 模式（OpenAI 兼容协议，示例） ────────────
# 切换到 online 时：APP_LLM_MODE=online 并按供应商填写以下项
# APP_CHAT_PROVIDER=openai
# APP_CHAT_MODEL=deepseek-chat
# APP_CHAT_BASE_URL=
# APP_CHAT_API_KEY=

# 温度 / 超时 / 重试（两种模式通用）
# 提取类任务（JD 关键点等）用独立低温减少字段漂移
APP_CHAT_TEMPERATURE=0.7
APP_CHAT_EXTRACT_TEMPERATURE=0.1
APP_CHAT_TIMEOUT_SECONDS=60
APP_CHAT_MAX_RETRIES=1

# ── Embedding：local 模式（本机 Ollama，1024 维） ─────────────
# 模型需先拉取：ollama pull bge-m3
APP_EMBEDDING_PROVIDER=ollama
APP_EMBEDDING_MODEL=bge-m3

# ── Embedding：online 模式（OpenAI 兼容协议，示例 SiliconFlow） ──
# APP_EMBEDDING_PROVIDER=openai
# APP_EMBEDDING_MODEL=BAAI/bge-m3
# APP_EMBEDDING_BASE_URL=
# APP_EMBEDDING_API_KEY=

# BGE-M3 为 1024 维，切换模型需保证维度一致或重建向量表
APP_EMBEDDING_DIMENSIONS=1024

# ── 数据库（必填；开发用 docker compose 的 pgvector 容器，宿主机端口默认 5433，见 README「本地启动」） ──
# 密码改为根目录 .env 里的 POSTGRES_PASSWORD
APP_DATABASE_URL=postgresql+asyncpg://postgres:change-me-please@localhost:5433/fc_interview

# ── 认证（JWT；生产环境务必更换 secret） ──────────────────────
APP_JWT_SECRET=dev-secret-change-me
APP_JWT_ALGORITHM=HS256
APP_JWT_EXPIRE_MINUTES=1440

# ── 面试行为（E4 配置化） ─────────────────────────────────────
APP_INTERVIEW_MAX_QUESTIONS=8
APP_INTERVIEW_MAX_FOLLOW_UPS=2
APP_INTERVIEW_MEMORY_WINDOW=20

# ── 知识库检索（E6：topK / 相似度阈值 / 切片参数） ────────────
APP_RAG_TOP_K=4
# cosine 距离上限（经 bge-m3 中文实测校准，与 config.py 默认值保持一致）
APP_RAG_SIMILARITY_THRESHOLD=0.42
APP_RAG_CHUNK_SIZE=500
APP_RAG_CHUNK_OVERLAP=50

# ── LangGraph 会话检查点（SqliteSaver，thread_id = 面试会话 id） ──
APP_CHECKPOINT_DB_PATH=data/checkpoints.sqlite

# ── CORS（JSON 数组） ─────────────────────────────────────────
APP_CORS_ORIGINS=["http://localhost:5173"]
