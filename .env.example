# PostgreSQL 容器凭据（开发数据库与打包分发共用；见 README「本地启动」）
# 复制为 .env 并修改密码后执行 docker compose up -d（.env 不入库；server/.env 的 APP_DATABASE_URL 同步此密码）
# 注意：密码会被拼接进数据库连接串，请勿使用 @ : / # % ? 等特殊字符（或自行做 URL 编码）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=fc_interview
# 宿主机映射端口（容器内固定 5432；默认 5433，避免与本机原生 PG 冲突）
POSTGRES_PORT=5433

# ── 全栈部署（docker compose up -d --build；M7）────────────────
# 宿主机映射端口（默认：server 8000 / client 8080；不填用默认值即可）
#SERVER_PORT=8000
#CLIENT_PORT=8080
# server 容器访问宿主机 Ollama 的地址（local 模式；默认已自动指向 host.docker.internal，
# 仅当 Ollama 不在本机时才需要修改）
#APP_OLLAMA_BASE_URL=http://host.docker.internal:11434
